---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MotionEnhancements from "../components/MotionEnhancements.astro";
import PageTransition from "../components/PageTransition.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
  preloadImages?: Array<string | {
    src: string;
    srcset?: Array<{ src: string; width: number }>;
    sizes?: string;
    type?: string;
  }>;
}

const {
  title = "Weihan Chen | Personal Blog",
  description = "Weihan Chen 的个人博客，记录角色设计、AI 工作流、代码与持续构建的项目。",
  image = "assets/character/sheep-hero.png",
  bodyClass = "",
  preloadImages = [],
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(`${base}${image}`, Astro.site);
const fullTitle = title === "Weihan Chen | Personal Blog" ? title : `${title} | Weihan Chen`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171719" />
    <ClientRouter fallback="swap" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="64x64" href={`${base}assets/character/favicon.png`} />
    <link rel="alternate" type="application/rss+xml" title="Weihan Chen Personal Blog" href={`${base}rss.xml`} />
    {preloadImages.map((image) => {
      const preload = typeof image === "string" ? { src: image } : image;
      const imageSrcSet = preload.srcset
        ?.map((source) => `${base}${source.src} ${source.width}w`)
        .join(", ");
      return (
        <link
          rel="preload"
          as="image"
          href={`${base}${preload.src}`}
          imagesrcset={imageSrcSet}
          imagesizes={preload.sizes}
          type={preload.type ?? "image/webp"}
          fetchpriority="high"
        />
      );
    })}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{fullTitle}</title>
  </head>
  <body class={bodyClass}>
    <PageTransition />
    <a class="skip-link" href="#content">跳到正文</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <MotionEnhancements />
    <Footer />
  </body>
</html>
