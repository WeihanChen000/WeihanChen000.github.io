---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/friends.css";

const friends = [
  {
    name: "Flurry's Blog",
    url: "https://blog.flurry.top/",
    avatar: "https://blog.flurry.top/apple-touch-icon.png",
    description: "记录技术和生活",
  },
  {
    name: "Yuxi Qian",
    url: "https://lkbrain.github.io/",
    avatar: "https://lkbrain.github.io/profile.webp",
    description: "AI4EDA 与芯片设计",
  },
];
---

<BaseLayout
  bodyClass="friends-page"
  title="友链"
  description="Weihan Chen 的友链目录，收藏持续记录技术、创作与生活的个人网站。"
>
  <section class="link-directory" aria-label="友链列表">
    <header class="friend-heading">
      <h1>友链</h1>
    </header>
    <div class="friend-files">
      {friends.map((friend, index) => (
        <a
          class="friend-file"
          href={friend.url}
          target="_blank"
          rel="noreferrer"
          aria-label={`访问 ${friend.name}`}
        >
          <span class="friend-file-fastener" aria-hidden="true"></span>
          <span class="friend-file-avatar" aria-hidden="true">
            <img
              src={friend.avatar}
              alt=""
              width="180"
              height="180"
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "low"}
              decoding="async"
              referrerpolicy="no-referrer"
            />
          </span>
          <div class="friend-file-copy">
            <h2>{friend.name}</h2>
            <p>{friend.description}</p>
          </div>
          <span class="friend-file-entry">访问 <span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
