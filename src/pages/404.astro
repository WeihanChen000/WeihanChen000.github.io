---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="页面未找到" description="这个地址没有对应的页面。">
  <section class="not-found">
    <p class="error-code">404</p>
    <h1>这个页面还没有被构建。</h1>
    <a class="primary-link" href={base}>回到首页 <span aria-hidden="true">&rarr;</span></a>
  </section>
</BaseLayout>
